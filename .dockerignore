# Never bake local environments, secrets, or build artifacts into images.
.git
.venv
.env
.env.*

# Python caches and local databases
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.docsbot_db/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Frontend artifacts (the frontend image builds its own)
node_modules
dist
frontend/node_modules
frontend/dist

# Editor / tool state
.idea/
.claude/
