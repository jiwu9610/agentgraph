# Copy this file to ".env" and paste your key.
# Get a FREE key at https://aistudio.google.com/apikey  (no credit card required)
GEMINI_API_KEY=your-key-here

# Optional: override the default chat model. gemini-2.5-flash is free.
# Cheapest/fastest option: gemini-2.5-flash-lite
# DOCSBOT_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# API service settings
# ----------------------------------------------------------------------------

# Where the on-disk vector store lives.
# DOCSBOT_DB_PATH=.docsbot_db

# API auth. CHANGE THESE before exposing the service anywhere.
# DOCSBOT_USER=admin
# DOCSBOT_PASSWORD=changeme
# DOCSBOT_SECRET=replace-with-a-long-random-string

# ----------------------------------------------------------------------------
# Knowledge-graph agent + Phoenix
# ----------------------------------------------------------------------------

# DOCSBOT_KG_DB_PATH=.docsbot_kg.sqlite
# DOCSBOT_SESSION_DB_PATH=.docsbot_sessions.sqlite
# DOCSBOT_EXTRACT_MODEL=gemini-2.5-flash-lite
# DOCSBOT_AGENT_MAX_HOPS=6
# DOCSBOT_AGENT_MAX_TOOL_CALLS=12
# DOCSBOT_AGENT_MAX_USD=0.05

# Phoenix collector (docker compose --profile obs up)
# PHOENIX_PROJECT_NAME=docsbot-kg
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# ----------------------------------------------------------------------------
# Rate limiting + Redis-backed chat sessions (optional; compose injects REDIS_URL)
# ----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# DOCSBOT_RATE_LIMIT_MAX_REQUESTS=60
# DOCSBOT_RATE_LIMIT_WINDOW_SECONDS=60
